<sdf version="1.6">
  <world name="test">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- A global light source -->
    <include>
      <uri>model://sun</uri>
    </include>
    <!-- A ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="heightmap">
        <static>true</static>
        <link name="link">
          <collision name="collision">
            <geometry>
              <heightmap>
                <uri>$HOME/Dropbox/csiro_ws/src/behaviour_rl_nav/gazebo/worlds/heightmap3.png</uri>
                <size>100 100 1.5</size>
                <pos>0 0 0</pos>
              </heightmap>
            </geometry>
          </collision>
          <visual name="visual_abcedf">
            <geometry>
              <heightmap>
                <uri>$HOME/Dropbox/csiro_ws/src/behaviour_rl_nav/gazebo/worlds/heightmap3.png</uri>
                <size>100 100 1.5</size>
                <pos>0 0 0</pos>
              </heightmap>
            </geometry>
          </visual>
        </link>
      </model>

  </world>
</sdf>