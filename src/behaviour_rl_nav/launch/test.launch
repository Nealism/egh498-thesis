      <arg name="multimaster" default="$(arg multimaster)"/>
      <arg name="mule_code" default="$(arg mule_code)"/>
      <arg name="mule_network" default="$(arg mule_network)"/>
      <arg name="output" value="$(arg output)"/>
      <arg name="platform" value="$(arg r1_plat)"/>
      <arg name="robot_name" value="r10"/>
      <arg name="wildcat_robot_name_file" value="$(find subt_launch)/config/wildcat/robot_name/r1.yaml"/>
