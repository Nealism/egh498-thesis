    <plugin filename="libgazebo_ros_control.so" name="titan_gazebo_ros_control">
      <robotDescription>titan_description</robotDescription>
      <robotBaseLink>base_link</robotBaseLink>
      <statePublisherRate>200.0</statePublisherRate>
      <robotNamespace>/titan</robotNamespace>
    </plugin>
    <plugin filename="libdynamic_titan_gazebo_ros.so" name="titan_dynamic_titan_gazebo_ros">
      <!--
        Commands are Twist that are converted into Pose and then sent to
            SimpleTrackedVehiclePlugin.
          * linear -> position
          * angular -> orientation (euler to quaternion using ignition math and
                       negating z)
      -->
      <is_ros_cmd_vel_stamped>true</is_ros_cmd_vel_stamped>
      <robot_namespace>/titan</robot_namespace>
      <ros_cmd_vel_topic>/titan/cmd_vel</ros_cmd_vel_topic>
      <timeout>10.0</timeout>
      <steering_efficiency>1.0</steering_efficiency>
      <track_separation>0.8</track_separation>
      <wheel_radius>0.14</wheel_radius>
      <max_track_velocity>4.0</max_track_velocity>
      <track_acceleration>12.0</track_acceleration>
      <sim_rate>200</sim_rate>
      <suspension_stiffness>200</suspension_stiffness>
      <suspension_preload>180</suspension_preload>
      <suspension_damping>200</suspension_damping>
      <suspension_reference>0.10</suspension_reference>
    </plugin>
  </gazebo>
  <!-- Dummy head link or for some reason it doesn't generate -->
  <link name="head_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.0001"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
