    <plugin filename="libSimpleTrackedVehiclePlugin.so" name="titan">
      <!--
        Commands are Pose:
          * position: x is used as the linear speed, clamped to
                      [-max_linear_speed, +max_linear_speed]
          * orientation: converted to euler rotation then the z angle is used as
                         the yaw rate (per second) clamped to
                         [-max_angular_speed, +max_angular_speed]
                         (this means angular cannot reach pi rad/s)

        Track velocities are then calculated as:
        leftVelocity = linearSpeed + angularSpeed * tracksSeparation / 2 / steeringEfficiency
        rightVelocity = linearSpeed - angularSpeed * tracksSeparation / 2 / steeringEfficiency
        Note that this is backwards if z is upward.

        This is then converted back to linear+angular:
        linearSpeed = (leftBeltSpeed + rightBeltSpeed) / 2
        angularSpeed = -(leftBeltSpeed - rightBeltSpeed) * steeringEfficiency / tracksSeparation

        Turn radius is calculated:
        desiredRotationRadiusSigned =
          if fabs(angularSpeed) < 0.1 then
            infinity (straight)
          else
            if fabs(linearSpeed) < 0.1 then
              0 (turn on spot)
            else
              linearSpeed / angularSpeed (turn while moving)
            endif
          endif

        From here on the code in SimpleTrackedVehiclePlugin gets more convoluted
        than I care to understand currently, but the friction in the tracks'
        contacts is used to produce the surface motion.
      -->
      <!-- SimpleTrackedVehiclePlugin -->
      <body>base_link</body>
      <collide_without_contact_bitmask>1</collide_without_contact_bitmask>
      <left_track>track_left</left_track>
      <right_track>track_right</right_track>
      <!-- TrackedVehiclePlugin -->
      <max_angular_speed>3.141592653589793</max_angular_speed>
      <max_linear_speed>10.0</max_linear_speed>
      <robot_namespace>/titan</robot_namespace>
      <steering_efficiency>1.0</steering_efficiency>
      <track_mu>2</track_mu>
      <!-- along tracks -->
      <track_mu2>0.5</track_mu2>
      <!-- across tracks -->
      <tracks_separation>0.8</tracks_separation>
    </plugin>
    <plugin filename="libtitan_gazebo.so" name="titan_gazebo">
      <!--
        Commands are Twist that are converted into Pose and then sent to
            SimpleTrackedVehiclePlugin.
          * linear -> position
          * angular -> orientation (euler to quaternion using ignition math and
                       negating z)
      -->
      <is_ros_cmd_vel_stamped>true</is_ros_cmd_vel_stamped>
      <robot_namespace>/titan</robot_namespace>
      <ros_cmd_vel_topic>/titan/cmd_vel</ros_cmd_vel_topic>
      <timeout>10.0</timeout>
    </plugin>
  </gazebo>
