<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="titan_track">

  <xacro:include filename="track.urdf.xacro"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
  </link>

  <xacro:property name="track_width" value="0.2"/>

  <xacro:titan_track name="track" width="${track_width}"/>

  <joint name="base_link_to_track" type="fixed">
    <parent link="base_link"/>
    <child link="track"/>
  </joint>

</robot>
