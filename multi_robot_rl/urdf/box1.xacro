<?xml version="1.0"?>
<robot name="simple_box1">
<link name="world"/>
  <link name="my_box1">
    <inertial>
      <origin xyz="24 1.4 0.5" />
      <mass value="1.0" />
      <inertia  ixx="1.0" ixy="0.0"  ixz="0.0"  iyy="100.0"  iyz="0.0"  izz="1.0" />
    </inertial>
    <visual>
      <origin xyz="24 1.4 0.5"/>
      <geometry>
        <!-- <box size="0.1 1.8 1" /> -->
        <box size="0.1 1.5 1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="24 1.4 0.5"/>
      <geometry>
        <!-- <box size="0.1 1.8 1" /> -->
        <box size="0.1 1.5 1" />
      </geometry>
    </collision>
  </link>
  <gazebo reference="my_box1">
    <material>Gazebo/Red</material>
  </gazebo>
    <joint name="joint_my_box" type="fixed">
    <origin rpy="0 0 0" xyz="-0.05 -0.15 0"/>
    <child link="my_box1"/>
    <parent link="world"/>
  </joint>
</robot>
