<?xml version="1.0"?>
<robot name="simple_box">
<link name="world"/>
  <link name="my_box">
    <inertial>
      <origin xyz="23.9 0 0.5" />
      <mass value="1.0" />
      <inertia  ixx="1.0" ixy="0.0"  ixz="0.0"  iyy="100.0"  iyz="0.0"  izz="1.0" />
    </inertial>
    <visual>
      <origin xyz="23.9 0 0.5"/>
      <geometry>
        <box size="0.1 1 1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="23.9 0 0.5"/>
      <geometry>
        <box size="0.1 1 1" />
      </geometry>
    </collision>
  </link>
  <gazebo reference="my_box">
    <material>Gazebo/Blue</material>
  </gazebo>
    <joint name="joint_my_box" type="fixed">
    <origin rpy="0 0 0" xyz="-0.05 -0.15 0"/>
    <child link="my_box"/>
    <parent link="world"/>
  </joint>
</robot>
